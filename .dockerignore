# Git files (keep .git for version detection in Dockerfile)
**/.gitignore
**/.gitattributes

# Python
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/*.egg-info/
**/dist/
**/build/
**/*.egg
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.venv/
**/venv/
**/ENV/
**/env/

# IDE
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/.marscode/

# Logs and temp
**/*.log
**/logs/
**/tmp/
**/temp/
**/*.tmp

# Test files
**/test/
**/tests/
**/*.test.py
**/sdk/python/test/
**/test/testcases/

# CI/CD
**/.github/
**/.gitlab-ci.yml
**/.jenkins/

# Backup files
**/*.backup
**/*.bak
**/*~

# ── deps build context (built as a separate image, mounted ──
# ── from infiniflow/ragflow_deps:latest by the main Dockerfile)     ──
# Excluding the directory contents keeps the main build context small
# regardless of which resources are prepared for the dependency image.
# The deps image is built from this directory with:
#   cd deps && docker build -f Dockerfile -t infiniflow/ragflow_deps .
# The native downloader tools/scripts/download_dev_deps.py is copied by the
# main Dockerfile (not excluded here) so build.sh can read its ORT version pin
# when running `./build.sh --go`.
deps/*

# Local configuration
**/.env.local
**/.env.*.local
**/*.local.json

# Node modules (will be installed in container)
**/node_modules/
**/web/node_modules/

# Build artifacts (will be created in container)
**/web/dist/
**/web/.next/
**/web/out/
**/cmake-build-*/

# Dependencies cache
**/.cache/
**/.npm/
**/.yarn/
**/.pnpm-store/

# Pulumi deployment (not needed in container)
**/pulumi_ragflow/
**/Pulumi.yaml

# Kubernetes configs (not needed in container)
**/k8s/

# But keep docker/*.yaml files needed for container
!**/docker/service_conf.yaml.template
!**/docker/nginx/*.conf

# Development scripts
**/build_*.sh
**/test_*.py
**/*.patch

# Misc
**/*.pid
**/*.seed
**/*.pid.lock

# ── Docker env (contains secrets) ───────────────────────────────────────────
docker/.env

# ── Local build artifacts / caches (never needed inside the container) ──
# Go build output (binaries are compiled fresh inside the go-builder stage).
/bin/
# Local Go module cache (go mod download runs inside the container via cache mount).
/gomod_cache/
# Local model backups / superseded exports in deepdoc_ee_models/.
deepdoc_ee_models/.bak*/
deepdoc_ee_models/.superseded*/
