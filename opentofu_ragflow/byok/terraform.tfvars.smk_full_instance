# =============================================================================
# RAGFlow Deployment on SMK - Single-Namespace Full Instance
# =============================================================================
# Legacy-style full stack in one namespace (infra + app together).
# Usage:
#   tofu plan  -var-file=terraform.tfvars.smk_full_instance -var 'namespace=ragflow'
#   tofu apply -var-file=terraform.tfvars.smk_full_instance -var 'namespace=ragflow'

cloud_provider = "smk"
load_balancer_provider = "metallb"
namespace      = "ragflow"

deploy_app_stack = true

# Full in-namespace stack
deploy_infra = true
# Optional local storage settings (replace with your own values or -var overrides)
s3_endpoint   = "http://rook-ceph-rgw-my-store.rook-ceph.svc:80"
s3_bucket     = "ragflow"
s3_prefix_path = ""
s3_region     = "default"
s3_access_key = "9YPCAWLZG3R8M30K7QGZ"
s3_secret_key = "r3iMxuwRqs9Y0pVd08VEaQQIWkWqGpwZzlL0zz50"

private_registry = "192.168.1.51/infiniflow-ai"
ragflow_image    = "ragflow:latest"

# =============================================================================
# Development-Specific Resource Overrides (reduced from production defaults)
# =============================================================================

# MySQL - reduced for dev
mysql_k8s_storage     = 20
mysql_cpu_request     = "2"
mysql_cpu_limit       = "8"
mysql_memory_request  = "8Gi"
mysql_memory_limit    = "16Gi"

# Elasticsearch - single node for dev
es_master_node_count    = 1
es_master_cpu_request   = "1"
es_master_cpu_limit     = "4"
es_master_memory_request = "4Gi"
es_master_memory_limit  = "4Gi"
es_master_heap_size    = "2g"
es_data_node_count      = 1
es_data_cpu_request    = "2"
es_data_cpu_limit      = "8"
es_data_memory_request = "16Gi"
es_data_memory_limit   = "16Gi"
es_data_heap_size      = "8g"
es_data_storage        = 20

# RabbitMQ - reduced for dev
rabbitmq_storage = 20

# RAGFlow application - reduced for dev
ragflow_replicas         = 1
ragflow_cpu_request     = "1"
ragflow_cpu_limit       = "4"
ragflow_memory_request  = "8Gi"
ragflow_memory_limit    = "16Gi"

# Parser replicas per task type
parser_replicas = {
  common   = 1
  graphrag = 1
  raptor   = 1
  resume   = 1
}
# parser_ws_workers = 2

# DeepDoc - reduced for dev
deepdoc_replicas = 1

# Redis - dev environment
redis_cpu_request    = "1"
redis_cpu_limit      = "4"
redis_memory_request = "4Gi"
redis_memory_limit   = "8Gi"

# TEI - dev environment
tei_replicas = 1

# =============================================================================
# Infinity (Shadow Database) - dev environment
# =============================================================================

infinity_enabled        = false
infinity_cpu_request    = "2"
infinity_cpu_limit      = "4"
infinity_memory_request = "4Gi"
infinity_memory_limit   = "16Gi"
infinity_storage        = 20

# =============================================================================
# ohttps Configuration (set for production)
# =============================================================================
ohttps_enabled = false
