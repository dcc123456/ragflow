# =============================================================================
# RAGFlow Deployment on Google Cloud Platform (GKE) - Development Environment
# =============================================================================
# Copy this file to terraform.tfvars before deployment: cp terraform.tfvars.dev_gke terraform.tfvars

# =============================================================================
# GKE-Specific Configuration
# =============================================================================

cloud_provider     = "gcp"
# GKE Autopilot requires premium-rwo for Elasticsearch mmap; standard-rwo is not supported
gcp_project_id     = "ragflow-462809"

# =============================================================================
# GCS Storage Configuration
# =============================================================================

s3_bucket = "ragflow-ragflow-462809-a243365a"
s3_region = "us-west1"

# Leave empty for GKE Workload Identity
s3_access_key = ""
s3_secret_key = ""

# =============================================================================
# Image Registry
# =============================================================================

private_registry = "gcr.io/ragflow-462809"

# =============================================================================
# Development-Specific Resource Overrides (reduced from production defaults)
# =============================================================================

# MySQL - reduced for dev
mysql_k8s_storage     = 20
mysql_cpu_request     = "2"
mysql_cpu_limit       = "8"
mysql_memory_request  = "8Gi"
mysql_memory_limit    = "16Gi"

# Elasticsearch - single node for dev
es_master_node_count    = 1
es_master_cpu_request   = "1"
es_master_cpu_limit     = "4"
es_master_memory_request = "4Gi"
es_master_memory_limit  = "4Gi"
es_master_heap_size    = "2g"
es_data_node_count      = 1
es_data_cpu_request    = "2"
es_data_cpu_limit      = "8"
es_data_memory_request = "16Gi"
es_data_memory_limit   = "16Gi"
es_data_heap_size      = "8g"
es_data_storage        = 20

# RabbitMQ - reduced for dev
rabbitmq_storage = 20

# RAGFlow application - reduced for dev
ragflow_replicas         = 1
ragflow_cpu_request     = "1"
ragflow_cpu_limit       = "4"
ragflow_memory_request  = "8Gi"
ragflow_memory_limit    = "16Gi"

# Parser replicas per task type
parser_replicas = {
  common   = 1
  graphrag = 1
  raptor   = 1
  resume   = 1
}
# parser_ws_workers = 2

# DeepDoc - reduced for dev
deepdoc_replicas = 1

# Redis - dev environment
redis_cpu_request    = "1"
redis_cpu_limit      = "4"
redis_memory_request = "4Gi"
redis_memory_limit   = "8Gi"

# TEI - dev environment
tei_replicas = 1

# =============================================================================
# Infinity (Shadow Database) - dev environment
# =============================================================================

infinity_enabled        = true
infinity_cpu_request    = "2"
infinity_cpu_limit      = "4"
infinity_memory_request = "4Gi"
infinity_memory_limit   = "16Gi"
infinity_storage        = 20

# =============================================================================
# ohttps Configuration (set for production)
# =============================================================================
ohttps_enabled = false
