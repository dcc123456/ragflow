FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
ARG NEED_MIRROR=1

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,id=ragflow_apt,target=/var/cache/apt,sharing=locked \
    if [ "$NEED_MIRROR" == "1" ]; then \
        sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
        mkdir -p /etc/uv && \
        echo 'python-install-mirror = "https://registry.npmmirror.com/-/binary/python-build-standalone/"' > /etc/uv/uv.toml && \
        echo '[[index]]' >> /etc/uv/uv.toml && \
        echo 'url = "https://pypi.tuna.tsinghua.edu.cn/simple"' >> /etc/uv/uv.toml && \
        echo 'default = true' >> /etc/uv/uv.toml; \
    fi; \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache && \
    chmod 1777 /tmp && \
    apt update && \
    apt --no-install-recommends install -y ca-certificates && \
    apt update && \
    apt install -y curl vim libgl1 libglib2.0-0 wget unzip libgomp1

# Install uv package manager
RUN --mount=type=bind,source=uv-x86_64-unknown-linux-gnu.tar.gz,target=/uv-x86_64-unknown-linux-gnu.tar.gz \
    tar xzvf /uv-x86_64-unknown-linux-gnu.tar.gz && \
    mv /uv-x86_64-unknown-linux-gnu/* /usr/local/bin/ && \
    rm -rf /uv-x86_64-unknown-linux-gnu

WORKDIR /app

# Install TensorRT 8.6.1 for CUDA 12.0 (compatible with Driver 535.x)
# Ubuntu 22.04 to match base image
# NOTE: Using TensorRT 8.6.1 as it's compatible with CUDA 12.0-12.1 / Driver 535
# TensorRT 8.6 GA supports CUDA 11.0-11.8 and 12.0-12.1 (NOT 12.2)
# TensorRT 10.x requires CUDA 12.6+ / Driver 550+
RUN --mount=type=bind,source=TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz,target=/TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz \
    tar -xzvf /TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz -C /tmp/ && \
    cp -rf /tmp/TensorRT-8.6.1.6/include/* /usr/local/cuda/include && \
    cp -rf /tmp/TensorRT-8.6.1.6/lib/* /usr/local/cuda/lib64/ && \
    echo '/usr/local/cuda/lib64' >> /etc/ld.so.conf.d/cuda.conf && \
    ldconfig && \
    rm -rf /tmp/TensorRT*

# Create unified Python environment with all dependencies
# Using pyproject.toml and uv.lock for dependency management
# Note: TensorRT C++ libraries (8.6.1) are pre-installed via tar.gz
# Python bindings will be installed from the wheel files included in the tar.gz
COPY deepdoc/servers/pyproject.toml deepdoc/servers/uv.lock /app/
RUN --mount=type=cache,id=ragflow_uv,target=/root/.cache/uv,sharing=locked \
    --mount=type=bind,source=TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz,target=/TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz \
    tar -xzvf /TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-12.0.tar.gz -C /tmp/ && \
    uv venv --python 3.11 && \
    # Install base dependencies from pyproject.toml (including gpu group with cuda-python)
    uv sync --group gpu --frozen && \
    # Install TensorRT Python bindings from wheel files (no network needed)
    # Use only Python 3.11 wheel to avoid conflicts
    uv pip install --no-index /tmp/TensorRT-8.6.1.6/python/tensorrt-8.6.1-cp311-none-linux_x86_64.whl && \
    # Verify TensorRT C++ libraries are accessible
    ldconfig -p | grep -E 'libnvinfer|libcudart' | head -5 && \
    # Verify TensorRT Python package is installed correctly
    uv run python3 -c "import tensorrt as trt; print(f'TensorRT version: {trt.__version__}')" && \
    # Install PaddlePaddle GPU from Baidu's wheel repository (CUDA 12.1)
    uv pip install paddlepaddle==3.0.0 --extra-index-url https://paddle-whl.bj.bcebos.com/stable/cu121/ && \
    rm -rf /tmp/TensorRT*

# Install YOLOv10 dependencies for DLA
# Use pre-downloaded yolov10.zip from download_deps.py
# Note: YOLOv10 requires Python 3.11 due to torch==2.0.1 compatibility
RUN --mount=type=bind,source=yolov10.zip,target=/yolov10.zip \
    unzip /yolov10.zip && \
    uv pip install -r yolov10-main/requirements.txt && \
    rm -rf yolov10-main

# Copy unified server modules (dla, ocr, tsr)
COPY deepdoc/servers/dla /app/dla
COPY deepdoc/servers/ocr /app/ocr
COPY deepdoc/servers/tsr /app/tsr

# Copy unified server entry point
COPY deepdoc/servers/deepdoc_svr.py /app/

# Copy dla and tsr files (generated on GPU host)
COPY dla.trt /app/dla/
COPY tsr.trt /app/tsr/

# Copy OCR files (downloaded via download_deps.py)
COPY .paddleocr /root/.paddleocr

ENV PYTHONPATH=/app
EXPOSE 8000

ENTRYPOINT ["/app/.venv/bin/python3", "/app/deepdoc_svr.py", "--gpu"]
