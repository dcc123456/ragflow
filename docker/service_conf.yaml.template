billing:
  stripe_api_key: '${BILLING_STRIPE_API_KEY:-sk_test_51TOCFU2XhWscgPRmTT7EcKsPc7g8CTiGtC6MY6IAUYWBF9P1y8bXjmpQiX7ecn1SUlu3qiwkz3hIpBM9lmSdXdPb00sKLS0WWt}'
  stripe_publishable_key: '${BILLING_STRIPE_PUBLISHABLE_KEY:-pk_test_51TOCFU2XhWscgPRmvl64yFyx6ZpCPDtUYFidcrefpjoJk4pDWuzZFycwSFXSMbNgiN6iRzovJdxUiP6nymVSI6ds004OM8okoV}'
  stripe_api_version: '${BILLING_STRIPE_API_VERSION:-2026-04-22.dahlia}'
  session_success_url: '${BILLING_SERVICE_URL:-http://127.0.0.1:9380}/v1/billing/success'
  session_cancel_url: '${BILLING_SERVICE_URL-http://127.0.0.1:9380}/v1/billing/cancel'
  webhook_url: '${BILLING_SERVICE_URL-http://127.0.0.1:9380}/v1/billing/webhook'
  customer_portal_return_url: '${BILLING_SERVICE_URL-http://127.0.0.1:9380}'
  price_point:
    - product_name: "deepdoc"
      price_type: "usage_based"
      billing_frequency: "one_time"
      unit: "page"
      unit_quantity: 1
      price_amount: 1
      price_currency: "usd"
      consuming_point_amount: 1  # points charged per page
  points_recharge:
    price_id: '${BILLING_PRICE_ID_POINTS:-price_1TPcBZ2XhWscgPRm3L4VEsJn}'
    points_per_unit: 100 # 1 quantity = 1 USD = 100 points (1 cent = 1 point)
  billing_plans:
    - name: "storage"
      quota_apps: 0
      quota_members: 0
      quota_storage: 1G
      quota_points: 0
      task_priority: "low"
      price_ids: '${BILLING_PRICE_ID_STORAGE:-price_1TOCKc2XhWscgPRmJRyTuo5g}'
      product_type: "addon"
      priority: 0
    - name: "Trial"
      quota_apps: 5
      quota_members: 1
      quota_storage: 100MB
      quota_points: 500  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: 10
      task_priority: "low"
      price_ids: '${BILLING_PRICE_ID_TRIAL:-price_1TPawr2XhWscgPRmFFLnlhpK}'
      product_type: "subscription"
      priority: 1
    - name: "Starter"
      quota_apps: 50
      quota_members: 5
      quota_storage: 5G
      quota_points: 5000  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: 100
      task_priority: "high"
      price_ids: '${BILLING_PRICE_ID_STARTER:-price_1TOCIQ2XhWscgPRmUhPHTvBD}'
      product_type: "subscription"
      priority: 2
    - name: "Pro"
      quota_apps: 100000
      quota_members: 20
      quota_storage: 50G
      quota_points: 20000  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: 1000
      task_priority: "high"
      price_ids: '${BILLING_PRICE_ID_PRO:-price_1TOCIi2XhWscgPRmpUCmNPE7}'
      product_type: "subscription"
      priority: 3
