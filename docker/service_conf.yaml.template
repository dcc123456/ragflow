rabbitmq:
  user: "${RABBITMQ_DEFAULT_USER:-rag_flow}"
  password: '${RABBITMQ_DEFAULT_PASS:-infini_rag_flow}'
  host: '${RABBITMQ_HOST:-rabbitmq}'
  port: 5672
  api_port: 15672
  exchange: "test1"

task_executor:
  message_queue_type: 'rabbitmq'

user_default_llm:
  default_models:
    embedding_model:
      factory: Builtin
      api_key: 'xxx'
      base_url: 'http://${TEI_HOST}:80'
