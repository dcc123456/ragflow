s3:
  access_key: '${S3_ACCESS_KEY:-}'
  secret_key: '${S3_SECRET_KEY:-}'
  region: '${S3_REGION:-us-east-1}'
  endpoint_url: '${S3_ENDPOINT:-}'
  bucket: '${S3_BUCKET:-ragflow}'
  prefix_path: ''
  signature_version: 'v4'
  addressing_style: 'path'
oss:
  access_key: '${S3_ACCESS_KEY:-}'
  secret_key: '${S3_SECRET_KEY:-}'
  endpoint_url: '${S3_ENDPOINT:-}'
  region: '${S3_REGION:-us-east-1}'
  bucket: '${S3_BUCKET:-ragflow}'
  prefix_path: '${S3_PREFIX_PATH:-}'
# GCS uses Workload Identity for authentication (GKE) or GOOGLE_APPLICATION_CREDENTIALS environment variable
# No access_key/secret_key needed - authentication is handled via GCP IAM service account
# For GKE: ensure the pod has Workload Identity configured with a service account that has Storage Object Admin role
# Endpoint URL is optional - used for GCS emulator testing (e.g., http://localhost:9999)
gcs:
  bucket: '${S3_BUCKET:-ragflow}'
  prefix_path: '${S3_PREFIX_PATH:-}'
  endpoint_url: '${S3_ENDPOINT:-}'

