billing:
  stripe_api_key: '${BILLING_STRIPE_API_KEY:-sk_test_51TOCFU2XhWscgPRmTT7EcKsPc7g8CTiGtC6MY6IAUYWBF9P1y8bXjmpQiX7ecn1SUlu3qiwkz3hIpBM9lmSdXdPb00sKLS0WWt}'
  stripe_publishable_key: '${BILLING_STRIPE_PUBLISHABLE_KEY:-pk_test_51TOCFU2XhWscgPRmvl64yFyx6ZpCPDtUYFidcrefpjoJk4pDWuzZFycwSFXSMbNgiN6iRzovJdxUiP6nymVSI6ds004OM8okoV}'
  stripe_api_version: '${BILLING_STRIPE_API_VERSION:-2026-04-22.dahlia}'
  webhook_url: '${BILLING_SERVICE_URL-http://127.0.0.1:9380}/api/v1/billing/webhooks/stripe'
  price_point:
    - product_name: "deepdoc"
      price_type: "usage_based"
      billing_frequency: "one_time"
      unit: "page"
      unit_quantity: 1
      price_amount: 1
      price_currency: "usd"
      consuming_point_amount: 1  # points charged per page
  points_recharge:
    price_id: '${BILLING_PRICE_ID_POINTS:-price_1TPcBZ2XhWscgPRm3L4VEsJn}'
    points_per_unit: 100 # 1 quantity = 1 USD = 100 points (1 cent = 1 point)
  billing_plans:
    - name: "storage"
      quota_apps: 0
      quota_members: 0
      quota_storage: '${BILLING_QUOTA_STORAGE_ADDON_STORAGE:-1G}'
      quota_points: 0
      task_priority: "low"
      price_ids: '${BILLING_PRICE_ID_STORAGE:-price_1TOCKc2XhWscgPRmJRyTuo5g}'
      product_type: "addon"
      priority: 0
    - name: "Trial"
      quota_apps: ${BILLING_QUOTA_TRIAL_APPS:-5}
      quota_members: ${BILLING_QUOTA_TRIAL_MEMBERS:-1}
      quota_storage: '${BILLING_QUOTA_TRIAL_STORAGE:-100MB}'
      quota_points: ${BILLING_QUOTA_TRIAL_POINTS:-500}  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: ${BILLING_QUOTA_TRIAL_RPM:-10}
      task_priority: "low"
      price_ids: 'price_trailtrailtrailtrailtrai'
      product_type: "subscription"
      priority: 1
    - name: "Starter"
      quota_apps: ${BILLING_QUOTA_STARTER_APPS:-50}
      quota_members: ${BILLING_QUOTA_STARTER_MEMBERS:-5}
      quota_storage: '${BILLING_QUOTA_STARTER_STORAGE:-5G}'
      quota_points: ${BILLING_QUOTA_STARTER_POINTS:-5000}  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: ${BILLING_QUOTA_STARTER_RPM:-100}
      task_priority: "high"
      price_ids: '${BILLING_PRICE_ID_STARTER:-price_1TXFtc2XhWscgPRmW3yCiEXV}'
      product_type: "subscription"
      priority: 2
    - name: "Pro"
      quota_apps: ${BILLING_QUOTA_PRO_APPS:-100000}
      quota_members: ${BILLING_QUOTA_PRO_MEMBERS:-20}
      quota_storage: '${BILLING_QUOTA_PRO_STORAGE:-50G}'
      quota_points: ${BILLING_QUOTA_PRO_POINTS:-20000}  # monthly quota (reset each billing cycle)
      api_request_limit_per_minute: ${BILLING_QUOTA_PRO_RPM:-1000}
      task_priority: "high"
      price_ids: '${BILLING_PRICE_ID_PRO:-price_1TXFux2XhWscgPRmdDLery5E}'
      product_type: "subscription"
      priority: 3
